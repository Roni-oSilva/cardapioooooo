# Configuração do agente local de impressão (copie para .env.agent ao lado de agent/print-agent.mjs)
SERVER_URL=https://cardapio.seurestaurante.com
PRINT_AGENT_TOKEN=mesmo-token-configurado-no-servidor
AGENT_NAME=caixa-01
POLL_MS=2000
# transport = imprime se a impressora aceitar os dados; status = exige resposta de status ESC/POS (mais rígido)
PRINT_CONFIRM=transport
# Só para testes: pasta onde destinos file:/... são permitidos (por padrão só /dev/...)
# ALLOW_FILE_DIR=/tmp/impressao
