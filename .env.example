# ---------- Banco de dados (PostgreSQL) ----------
DATABASE_URL=postgres://usuario:senha@localhost:5432/cardapio
# Em provedores gerenciados (Supabase, Neon, RDS) use "require"; em Postgres local deixe vazio.
DATABASE_SSL=

# ---------- Autenticação ----------
# Gere com: openssl rand -hex 32  (mínimo 32 caracteres)
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Usuário administrador criado pelo "npm run db:seed" (troque a senha após o primeiro login)
SEED_ADMIN_EMAIL=admin@restaurante.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# ---------- Impressão automática ----------
# Token compartilhado entre o servidor e o agente local de impressão.
# Gere com: openssl rand -hex 24
PRINT_AGENT_TOKEN=troque-por-um-token-aleatorio

# ---------- Uploads de imagens ----------
# Pasta persistente no servidor. Em hospedagem efêmera (Vercel, etc.) use um volume ou troque por S3/Supabase Storage.
UPLOAD_DIR=./uploads

# ---------- Geral ----------
# URL pública do sistema (usada em links de acompanhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
